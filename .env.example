# MedPilot Environment Configuration

# Server
PORT=8000
HOST=127.0.0.1
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL / Supabase)
# If using Supabase, paste your PostgreSQL connection string:
# postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./medpilot.db

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
STORAGE_BUCKET=medpilot-resources

# LLM Providers (Gemini is default)
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Security
SECRET_KEY=medpilot-academic-companion-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
